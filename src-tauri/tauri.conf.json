{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "director-cut",
  "version": "0.1.0",
  "identifier": "com.director-cut.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Director's Cut",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "resources": {
      "../backend/app": "backend/app",
      "../backend/main.py": "backend/main.py",
      "../backend/pyproject.toml": "backend/pyproject.toml",
      "../backend/.env": "backend/.env"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
